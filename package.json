{
  "name": "curling-front-temp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "meili:up": "docker compose -f docker/meilisearch/docker-compose.yml --env-file .env up -d",
    "meili:down": "docker compose -f docker/meilisearch/docker-compose.yml --env-file .env down",
    "meili:logs": "docker compose -f docker/meilisearch/docker-compose.yml logs -f meilisearch",
    "meili:health": "tsx --env-file=.env scripts/meili/health.ts",
    "meili:setup": "tsx --env-file=.env scripts/meili/setup-index.ts",
    "meili:index": "tsx --env-file=.env scripts/meili/index-designers.ts",
    "meili:reset": "tsx --env-file=.env scripts/meili/reset-index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.104.0",
    "@vis.gl/react-google-maps": "^1.8.3",
    "embla-carousel-react": "^8.6.0",
    "meilisearch": "^0.58.0",
    "next": "16.2.2",
    "pretendard": "^1.3.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.1",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-onboarding": "^10.3.3",
    "@storybook/addon-vitest": "^10.3.3",
    "@storybook/nextjs-vite": "^10.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "eslint-plugin-storybook": "^10.3.3",
    "playwright": "^1.59.0",
    "prettier": "^3.8.1",
    "storybook": "^10.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
